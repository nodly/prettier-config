{
  "name": "@nodly/prettier-config",
  "type": "module",
  "version": "6.0.0",
  "description": "A shareable configuration for prettier.",
  "author": "Nodly AB",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodly/prettier-config.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/prettier.config.js",
  "module": "./dist/prettier.config.js",
  "types": "./dist/prettier.config.d.ts",
  "exports": {
    ".": {
      "import": "./dist/prettier.config.js",
      "types": "./dist/prettier.config.d.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "packageManager": "pnpm@12.20.0+sha512.6ccc74997ccef4e67999788e18dbfbfa583e2a849668668db4707b6a8306662f47156e650232a985bd3ec24cf9364c1aa154d37e51ed7aac62c1cd1e3afc80c3"
}
